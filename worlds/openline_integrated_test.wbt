#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  basicTimeStep 8
}

Viewpoint {
  orientation 0 0 1 0
  position 0 0 2.2
  fieldOfView 1.2
}

Background {
  skyColor [ 0.15 0.18 0.22 ]
}

DirectionalLight {
  direction -0.4 -0.6 -1
  intensity 1
}

# Static white floor; built-in collision surface
Floor {
  size 2 1.2
  appearance PBRAppearance {
    baseColor 0.92 0.92 0.92
    roughness 1
  }
}

