# Differential-drive robot: ESP32 + L298N behavior is represented by
# one velocity-controlled motor per DC gearbox motor.
Robot {
  translation 0 -0.32 0.035
  name "OpenLineRobot"
  controller "line_follower"
  children [
    # Chassis
    Shape {
      appearance PBRAppearance {
        baseColor 0.04 0.22 0.72
        roughness 0.55
        metalness 0.12
      }
      geometry Box { size 0.18 0.13 0.022 }
    }

    # Left wheel and motor
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 0.075 0
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          maxVelocity 8
          maxTorque 0.8
        }
      ]
      endPoint Solid {
        translation 0 0.075 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.06 0.06 0.06
              roughness 1
            }
            geometry Cylinder { radius 0.035 height 0.02 }
          }
        ]
        name "left_wheel"
        boundingObject Cylinder { radius 0.035 height 0.02 }
        physics Physics { density -1 mass 0.05 }
      }
    }

    # Right wheel and motor
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 -0.075 0
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          maxVelocity 8
          maxTorque 0.8
        }
      ]
      endPoint Solid {
        translation 0 -0.075 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.06 0.06 0.06
              roughness 1
            }
            geometry Cylinder { radius 0.035 height 0.02 }
          }
        ]
        name "right_wheel"
        boundingObject Cylinder { radius 0.035 height 0.02 }
        physics Physics { density -1 mass 0.05 }
      }
    }

    # Three downward-facing cameras approximate the three TCRT5000 modules.
    Transform {
      translation 0.085 0.035 -0.022
      children [
        Camera {
          name "left sensor"
          width 1
          height 1
          fieldOfView 0.05
          near 0.001
          far 0.2
        }
      ]
    }
    Transform {
      translation 0.085 0 -0.022
      children [
        Camera {
          name "center sensor"
          width 1
          height 1
          fieldOfView 0.05
          near 0.001
          far 0.2
        }
      ]
    }
    Transform {
      translation 0.085 -0.035 -0.022
      children [
        Camera {
          name "right sensor"
          width 1
          height 1
          fieldOfView 0.05
          near 0.001
          far 0.2
        }
      ]
    }

    # Rear caster visual
    Transform {
      translation -0.065 0 -0.017
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.65 0.65 0.65 }
          geometry Sphere { radius 0.018 }
        }
      ]
    }
  ]

  # The chassis and passive rear caster share the robot body collision shape.
  boundingObject Group {
    children [
      Box { size 0.18 0.13 0.022 }
      Transform {
        translation -0.065 0 -0.022
        children [ Sphere { radius 0.018 } ]
      }
    ]
  }
  physics Physics { density -1 mass 0.35 }
}
