#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 16
}

Viewpoint {
  orientation 0.57735 0.57735 0.57735 2.0944
  position 1.8 -2.0 1.8
}

Background {
  skyColor [ 0.15 0.18 0.22 ]
}

DirectionalLight {
  direction -0.4 -0.6 -1
  intensity 1
}

# White arena
Solid {
  translation 0 0 -0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.92 0.92 0.92
        roughness 1
      }
      geometry Box { size 2 1.2 0.02 }
    }
  ]
  name "white_arena"
  boundingObject Box { size 2 1.2 0.02 }
}

# Straight black line
Solid {
  translation 0 0 0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.015 0.015 0.015
        roughness 1
      }
      geometry Box { size 1.75 0.065 0.002 }
    }
  ]
  name "black_track"
}

Robot {
  translation -0.72 0 0.035
  name "OpenLineRobot"
  controller "line_follower"
  children [
    # Blue chassis
    Shape {
      appearance PBRAppearance {
        baseColor 0.04 0.22 0.72
        roughness 0.55
        metalness 0.12
      }
      geometry Box { size 0.18 0.13 0.022 }
    }

    # Left wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 0.075 0
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          maxVelocity 20
          maxTorque 2
        }
      ]
      endPoint Solid {
        translation 0 0.075 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.06 0.06 0.06
              roughness 1
            }
            geometry Cylinder { radius 0.035 height 0.02 }
          }
        ]
        name "left_wheel"
        boundingObject Cylinder { radius 0.035 height 0.02 }
        physics Physics { density -1 mass 0.05 }
      }
    }

    # Right wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 -0.075 0
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          maxVelocity 20
          maxTorque 2
        }
      ]
      endPoint Solid {
        translation 0 -0.075 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.06 0.06 0.06
              roughness 1
            }
            geometry Cylinder { radius 0.035 height 0.02 }
          }
        ]
        name "right_wheel"
        boundingObject Cylinder { radius 0.035 height 0.02 }
        physics Physics { density -1 mass 0.05 }
      }
    }

    # Three downward-facing camera sensors
    Transform {
      translation 0.085 0.035 -0.022
      children [
        Camera {
          name "left sensor"
          width 1
          height 1
          fieldOfView 0.1
          near 0.005
          far 0.5
        }
        Shape {
          appearance PBRAppearance { baseColor 0.9 0.2 0.1 }
          geometry Sphere { radius 0.008 }
        }
      ]
    }
    Transform {
      translation 0.085 0 -0.022
      children [
        Camera {
          name "center sensor"
          width 1
          height 1
          fieldOfView 0.1
          near 0.005
          far 0.5
        }
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.8 0.2 }
          geometry Sphere { radius 0.008 }
        }
      ]
    }
    Transform {
      translation 0.085 -0.035 -0.022
      children [
        Camera {
          name "right sensor"
          width 1
          height 1
          fieldOfView 0.1
          near 0.005
          far 0.5
        }
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.3 0.95 }
          geometry Sphere { radius 0.008 }
        }
      ]
    }

    # Rear caster visual
    Transform {
      translation -0.065 0 -0.025
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.65 0.65 0.65 }
          geometry Sphere { radius 0.018 }
        }
      ]
    }
  ]
  boundingObject Box { size 0.18 0.13 0.022 }
  physics Physics { density -1 mass 0.35 }
}
